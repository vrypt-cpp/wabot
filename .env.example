# MySQL (Aiven Cloud — pastikan SSL aktif di mysqlPool.js)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Bot Configuration
OWNER_NUMBER=
PHONE_NUMBER=

# Server
PORT=

# Logging: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Hot-reload file watcher: aktifkan hanya saat development (true/false)
HOT_RELOAD=false